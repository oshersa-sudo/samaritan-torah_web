__pycache__/
*.pyc
*.pyo
.buildozer/
bin/
build/
data/WLC.db
.claude/
*.log

# secrets — never commit
.env

# editing backups created during this work
*.bak
*.bak_*
*.bak[0-9]*
*.feature_bak
*.marks.bak
*.marks2.bak
*.corr.bak
~$*

# large raw / intermediate research data (not needed to run the app)
data/_*
data/dict_ocr/
data/Genesis_Pic/
*.apk
# ...except the published Android app, which the site serves as a download
!web/downloads/*.apk
data/vongall/

# generated read-aloud audio cache
data/tts_cache/

# rendered HaMeliṣ page images (regenerable)
data/meliz/pages/

# re-downloadable Sefaria Onkelos cache
data/onkelos/cache/

# re-downloadable Sefaria Hebrew cache (for content re-alignment)
data/onkelos/heb_cache/

# local visit-analytics DB (admin dashboard) — resets on redeploy without a
# persistent disk; never meant to be committed
data/analytics.db

# dict_expand: bulky intermediates, regenerable by scripts/dict_expand/*.py
data/dict_expand/proposals.tsv
data/dict_expand/phrase_candidates.tsv
data/dict_expand/*.pkl
data/dict_expand/dictionary_backup_pre_expand.sql
