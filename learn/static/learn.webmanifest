{
  "id": "/?app=onyx-learn",
  "name": "Onyx לימודי — תרגול ומעקב",
  "short_name": "Onyx לימודי",
  "description": "אימון יומי לילדים באנגלית, עברית, חשבון, מדעים, תורה ולשון — מילים, קריאה, חידונים ומשחקים, עם מעקב הורים אחר ההתקדמות.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "/exam",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f1ecff",
  "theme_color": "#7c3aed",
  "categories": ["education", "kids"],
  "icons": [
    { "src": "/static/img/onyx_learn_icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/onyx_learn_icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/onyx_learn_icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/img/onyx_learn_icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/img/onyx_learn_icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "התחלת תרגול", "short_name": "תרגול", "url": "/exam",
      "icons": [{ "src": "/static/img/onyx_learn_icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "מעקב הורים", "short_name": "מעקב", "url": "/parent",
      "icons": [{ "src": "/static/img/onyx_learn_icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/static/img/shot-hub.png",      "sizes": "900x1840", "type": "image/png", "form_factor": "narrow", "label": "בחירת מקצוע" },
    { "src": "/static/img/shot-exercise.png", "sizes": "900x1840", "type": "image/png", "form_factor": "narrow", "label": "תרגול אינטראקטיבי" },
    { "src": "/static/img/shot-parent.png",   "sizes": "900x1840", "type": "image/png", "form_factor": "narrow", "label": "מעקב הורים" }
  ]
}
